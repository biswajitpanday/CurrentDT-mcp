{
  "defaultFormat": "iso",
  "defaultProvider": "local",
  "providers": {
    "local": {
      "name": "local",
      "priority": 1
    },
    "remote": {
      "name": "remote",
      "priority": 2,
      "config": {
        "url": "https://worldtimeapi.org/api/timezone/UTC",
        "timeout": 5000
      }
    }
  },
  "debug": false,
  "logLevel": "error"
}
